<?xml version="1.0" encoding="utf-8"?>
<!--
  Local MSBuild property overrides.
  Copy this file to Directory.Build.props.user and edit as needed.
  Directory.Build.props.user is gitignored and imported automatically by MSBuild.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Default package lane for local builds: v17 (repo default) or v18 -->
    <ArticulatePackageLane>v17</ArticulatePackageLane>

    <!-- Disable the TypeScript client build for faster local iteration in VS/Rider -->
    <EnableClientBuild>false</EnableClientBuild>

    <!-- Build configuration override -->
    <!--<BUILD_CONFIGURATION>Debug</BUILD_CONFIGURATION>-->
  </PropertyGroup>
</Project>
