<?xml version="1.0" encoding="utf-8"?>
<!--
  Local MSBuild property overrides for Visual Studio.
  Copy this file to `Directory.Build.props.user` and edit as needed.
  This file is user-specific, gitignored, and imported automatically by MSBuild.
  CI/build scripts (__build.cs__ or __build.yml__) take precedence because
  they pass command-line properties (-p:...) to `dotnet` which override this file.
  Each lane has its own bin/obj, so switching lanes needs no clean.
  With EnableClientBuild=false, build the lane's Backoffice client once with
  the build script's client command (see build/help.md).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Default package lane for local builds: choose v17, v18 or v19 -->
    <ArticulatePackageLane>v17</ArticulatePackageLane>

    <!-- Disable the TypeScript client build for faster local iteration in the IDE.
         CI/CD pipelines will still run the client build.
         Enabling this in the IDE may cause IO lock issues due to Visual Studio's competing background compilation.
    -->
    <EnableClientBuild>false</EnableClientBuild>

    <!-- TinyMCE.Umbraco override -->
    <UseTinyMceUmbraco>false</UseTinyMceUmbraco>

  </PropertyGroup>
</Project>
