{
    "name": "Articulate Dev",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "runArgs": ["--memory=8g", "--shm-size=1g"],
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "forwardPorts": [
        8080,
        8443,
        44366
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp",
                "ms-azuretools.vscode-docker",
                "EditorConfig.EditorConfig",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "runem.lit-plugin"
            ],
            "settings": {
                "dotnet.defaultSolution": "${workspaceFolder}/src/Articulate.sln",
                "dotnet.solution.autoOpen": "${workspaceFolder}/src/Articulate.sln"
            }
        }
    },
    "postCreateCommand": "cd src && dotnet restore",
    "postStartCommand": "sudo chown -R vscode:vscode /workspaces/${localWorkspaceFolderBasename} || true && mkdir -p /workspaces/${localWorkspaceFolderBasename}/.pnpm-store && pnpm config set store-dir /workspaces/${localWorkspaceFolderBasename}/.pnpm-store",
    "remoteUser": "vscode"
}