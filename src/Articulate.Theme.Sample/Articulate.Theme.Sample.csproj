<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Articulate.Theme.Sample</PackageId>
    <Title>Articulate Theme Sample</Title>
    <AssemblyName>Articulate.Theme.Sample</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <RootNamespace>Articulate.Theme.Sample</RootNamespace>
    <Description>A modern sample Articulate theme for Umbraco 17+.</Description>
    <Nullable>enable</Nullable>
    <UseArticulateUsings>false</UseArticulateUsings>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Theme.Sample ships from the same build pass as Articulate; the v18 stable nupkg's
         dep range surfaces a v17 prerelease only because ProjectVersion on the inner project
         build isn't overridden (see Directory.Build.props OverrideArticulatePackageVersion).
         The artifact is never published, so just quiet the warning. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Articulate\Articulate.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Articulate.Web\Articulate.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="$(MSBuildProjectDirectory)\..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Lock files are restore-time inputs for <RestoreLockedMode>; never ship them. -->
  <ItemGroup>
    <Content Remove="packages.*.lock.json" />
    <None Remove="packages.*.lock.json" />
  </ItemGroup>

</Project>
