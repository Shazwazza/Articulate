@model PostModel
@inject IArticulateThemeRepository ThemeRepository

@if (Model.IsCommentsEnabled)
{
    switch (Model.CommentsProvider)
    {
        case ArticulateConstants.Comments.Provider.Disqus:
            <div id="disqus_thread">
                <script type="text/javascript">
                    var disqus_config = function () {
                        this.page.url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Url(mode: UrlMode.Absolute)));
                        this.page.identifier = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Key));
                    };
                    (function () {
                        var d = document, s = d.createElement('script');
                        const disqusShortName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DisqusShortName));
                        s.src = 'https://' + disqusShortName + '.disqus.com/embed.js';
                        s.setAttribute('data-timestamp', +new Date());
                        (d.head || d.body).appendChild(s);
                    })();
                </script>
                <noscript>
                    Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript" target="_blank" rel="noopener noreferrer" title="Disqus comments">comments powered by Disqus.</a>
                </noscript>
            </div>
            break;
        case ArticulateConstants.Comments.Provider.Giscus:
            <div id="comments">
                <script src="@Model.GiscusScriptSrc"
                        data-repo="@Model.GiscusRepo"
                        data-repo-id="@Model.GiscusRepoId"
                        data-category="@Model.GiscusCategory"
                        data-category-id="@Model.GiscusCategoryId"
                        data-mapping="@Model.GiscusMapping"
                        data-strict="@Model.GiscusStrict"
                        data-reactions-enabled="@Model.GiscusReactionsEnabled"
                        data-emit-metadata="@Model.GiscusEmitMetadata"
                        data-input-position="@Model.GiscusInputPosition"
                        data-theme="@(GiscusCommentsOptions.ResolveGiscusTheme(Model.GiscusTheme, ThemeRepository.GetThemeAssetUrl(Model.Theme, "giscus.css", Context.Request)))"
                        data-lang="@Model.GiscusLang"
                        @if (!string.IsNullOrEmpty(Model.GiscusLoading))
                        {
                            <text>data-loading="@Model.GiscusLoading"</text>
                        }
                        crossorigin="anonymous"
                        async>
                </script>
                <script>
                    (function () {
                        window.addEventListener('message', function (e) {
                            if (e.origin !== 'https://giscus.app') return;
                            var d = e.data; if (!d || !d.giscus || typeof d.giscus.resize === 'undefined') return;
                            var f = document.querySelector('iframe.giscus-frame');
                            if (f) f.style.height = d.giscus.resize + 'px';
                        });
                    })();
                </script>
                <noscript>
                    Please enable JavaScript to view the <a href="https://github.com/@Uri.EscapeDataString(Model.GiscusRepo).Replace("%2F", "/")/discussions" target="_blank" rel="noopener noreferrer" title="Giscus comments">comments powered by Giscus.</a>
                </noscript>
            </div>
            break;
        default:
            break;
    }
}
