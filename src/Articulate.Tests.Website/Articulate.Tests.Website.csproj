<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseArticulateUsings>false</UseArticulateUsings>
    <UseTinyMceUmbraco Condition="'$(UseTinyMceUmbraco)' == ''">false</UseTinyMceUmbraco>
    <!-- TinyMceUmbracoPackageVersion comes from Directory.Packages.props (CPM, per-lane floor). -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Umbraco.Cms" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseTinyMceUmbraco)' == 'true'">
    <PackageReference Include="TinyMCE.Umbraco" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' and ($([System.String]::Copy('$(UmbracoCmsPackageVersion)').StartsWith('[17.')) or $([System.String]::Copy('$(UmbracoCmsPackageVersion)').StartsWith('[18.')))">
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
  </ItemGroup>
  <!-- Umbraco.Code 3 for v18 allows Roslyn 5.x, but NuGet otherwise selects Workspaces 5.0 while Common/CSharp resolve to 5.3. Align them. -->
  <ItemGroup Condition="'$(ArticulatePackageLane)' == 'v18'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>
  <!-- Reference Articulate.Web (which depends on the other projects) for development mode -->
  <ItemGroup>
    <ProjectReference Include="..\Articulate.Web\Articulate.Web.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <CopyStaticWebAssetsToPublish>true</CopyStaticWebAssetsToPublish>
    </ProjectReference>
    <ProjectReference Include="..\Articulate.Theme.Sample\Articulate.Theme.Sample.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <CopyStaticWebAssetsToPublish>true</CopyStaticWebAssetsToPublish>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="umbraco\**" />
    <Content Remove="umbraco\**" />
    <EmbeddedResource Remove="umbraco\**" />
    <None Remove="umbraco\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- tells 'dotnet watch' to ignore any file changes  under the umbraco/ folder and its subdirectories. -->
    <Watch Remove="umbraco\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Views\ArticulateThemes\" />
    <Folder Include="wwwroot\App_Plugins\Articulate\Themes\" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>
  <!-- Set this to true if ModelsBuilder mode is not InMemoryAuto-->
  <PropertyGroup>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>
</Project>
