@model ListModel
@{
    Layout = "Master.cshtml";
    var posts = Model.Posts.ToList();
}

<div class="container">

    <!-- HEADER COLUMN --->
    <div class="header-col">
        <header>
            @await Html.PartialAsync("Header", Model)
        </header>
    </div>

    <!--- MAIN COLUMN --->
    <div class="main-col">
        @if (!posts.Any())
        {
            <article>No blog posts found</article>
        }
        else
        {
            foreach (var post in posts)
            {
                <div class="post-entry post-list">
                    <article role="article" itemscope itemtype="http://schema.org/Article">
                        <div class="post-side">
                            <time datetime="@post.PublishedDate.ToString("yyyy MMM dd")" itemprop="datePublished" class="post-date">
                                <span class="year">@post.PublishedDate.ToString("yyyy")</span>
                                <span class="datetime-month">@post.PublishedDate.ToString("MMM")</span><br>
                                <span class="datetime-day">@post.PublishedDate.ToString("dd")</span>
                            </time>
                        </div>
                        <div class="post-main">
                            <a href="@post.Url()" class="post-list-link">
                                <div>
                                    <h2>@post.Name</h2>
                                    @{
                                        var thumbnail = post.PostImage?.GetCropUrl(cropAlias: "thumbnail", preferFocalPoint: true, useCropDimensions: true);
                                        if (thumbnail != null)
                                        {
                                            <img class="thumb" src="@thumbnail" alt="@post.Name"/>
                                        }
                                    }
                                    @post.Excerpt
                                    <span class="readmore">
                                        <i class="fa-solid fa-plus-square plus-sign"></i>
                                        <span class="readmore-hover">READ MORE</span>
                                    </span>
                                </div>
                            </a>
                            <div class="post-info">

                                @if (post.Tags.Any())
                                {
                                    <div class="tags">
                                        <i class="fa-solid fa-tags fa-lg"></i>
                                        @await Html.PartialAsync("PostTags", post)
                                    </div>
                                }

                            </div>
                        </div>
                    </article>
                </div>
            }
        }


        @await Html.PartialAsync("Pager", Model.Pages)

        @await Html.PartialAsync("Footer")

    </div>
</div>
