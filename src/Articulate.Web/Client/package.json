{
  "name": "articulate-backoffice-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:v17": "pnpm --filter articulate-backoffice-v17 run dev",
    "dev:v18": "pnpm --filter articulate-backoffice-v18 run dev",
    "dev": "pnpm run dev:v17 & pnpm run dev:v18",
    "build:v17": "pnpm --filter articulate-backoffice-v17 run build",
    "build:v18": "pnpm --filter articulate-backoffice-v18 run build",
    "build": "pnpm run build:v17 && pnpm run build:v18",
    "build:dev:v17": "pnpm --filter articulate-backoffice-v17 run build:dev",
    "build:dev:v18": "pnpm --filter articulate-backoffice-v18 run build:dev",
    "build:dev": "pnpm run build:dev:v17 && pnpm run build:dev:v18",
    "check": "pnpm --filter articulate-backoffice-v17 run check && pnpm --filter articulate-backoffice-v18 run check",
    "lint:v17": "pnpm --filter articulate-backoffice-v17 run lint",
    "lint:v18": "pnpm --filter articulate-backoffice-v18 run lint",
    "lint": "pnpm run lint:v17 && pnpm run lint:v18",
    "lint:fix:v17": "pnpm --filter articulate-backoffice-v17 run lint:fix",
    "lint:fix:v18": "pnpm --filter articulate-backoffice-v18 run lint:fix",
    "lint:fix": "pnpm run lint:fix:v17 && pnpm run lint:fix:v18",
    "generate:api:v17": "pnpm --filter articulate-backoffice-v17 run generate:api",
    "generate:api:v18": "pnpm --filter articulate-backoffice-v18 run generate:api"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "@types/node": "^24",
    "@umbraco-cms/backoffice": "^17.6.2",
    "chalk": "^5.6.2",
    "node-fetch": "^3.3.2",
    "vite": "^8.2.0"
  }
}
