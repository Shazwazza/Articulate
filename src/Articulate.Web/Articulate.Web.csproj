<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Articulate</PackageId>
    <Title>Articulate</Title>
    <AssemblyName>Articulate.Web</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <nullable>enable</nullable>
    <UseArticulateUsings>true</UseArticulateUsings>
    <!-- ENABLE Modern Web Assets (Replaces the need for targets files) -->
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <!-- note: net11 packs a build/Articulate.targets stub that only imports Microsoft.AspNetCore.StaticWebAssets.targets; build/Articulate.targets already imports it. -->
    <NoWarn Condition="'$(ArticulatePackageLane)' == 'v19'">$(NoWarn);NU5118</NoWarn>
    <!-- Allow Hybrid Mode (Serve as StaticContent, Embed as Resource) -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);IncludeProjectReferenceDlls
    </TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Articulate\Articulate.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship Articulate.dll alongside Articulate.Web.dll via BuildOutputInPackage. -->
  <Target Name="IncludeProjectReferenceDlls">
    <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_ProjectReferenceTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_ProjectReferenceDocumentation Include="@(_ProjectReferenceTargetPath->'%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_ProjectReferenceTargetPath)" />
      <BuildOutputInPackage Include="@(_ProjectReferenceDocumentation)" Condition="Exists('%(_ProjectReferenceDocumentation.Identity)')" />
    </ItemGroup>
  </Target>
  <!--
    Articulate.Core's runtime deps (ProjectReference is PrivateAssets, so
    they have to be redeclared here for the packed Articulate nuspec).
    Keep this in sync with src/Articulate/Articulate.csproj.
  -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="OpenIddict.Abstractions" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Argotic.Core" />
    <PackageReference Include="FileSignatures" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="WilderMinds.MetaWeblog" />
    <PackageReference Include="System.ServiceModel.Syndication" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <!-- Build targets shipped with the package (copies XML docs for Swagger) -->
  <ItemGroup>
    <Content Include="build\Articulate.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!-- Lock files are restore-time inputs for <RestoreLockedMode>; never ship them. -->
  <ItemGroup>
    <Content Remove="packages.*.lock.json" />
    <None Remove="packages.*.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed theme VIEWS from App_Plugins -->
    <EmbeddedResource Include="App_Plugins\Articulate\Themes\**\Views\**">
      <LogicalName>Articulate.Theme://Themes/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Embed theme ASSETS from wwwroot -->
    <EmbeddedResource Include="wwwroot\App_Plugins\Articulate\Themes\**\assets\**">
      <LogicalName>Articulate.Theme://Themes/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Client sources are build inputs; only compiled BackOffice assets belong in the package. -->
  <ItemGroup>
    <Content Remove="Client\**" />
  </ItemGroup>
  <PropertyGroup>
    <ClientProjectDirectory>$(MSBuildProjectDirectory)/Client</ClientProjectDirectory>
    <!-- Vite output; see Client/common/vite.config.ts. -->
    <ClientAssetsDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)ClientAssets\</ClientAssetsDir>
    <ClientBuildMode>prod</ClientBuildMode>
    <ClientBuildMode Condition="$([System.String]::Copy('$(ClientBuildCommand)').Contains('build:dev'))">dev</ClientBuildMode>
    <!-- A package version change rebuilds the client. -->
    <ClientBuildStamp>$(BaseIntermediateOutputPath)BackofficeClient_$(ArticulatePackageLane)_$(ClientBuildMode)_$(ArticulatePackageVersion).stamp</ClientBuildStamp>
    <!-- Each lane has a Client/<lane> workspace pinning its @umbraco-cms/backoffice major. -->
    <ClientWorkspaceDirectory>$(ClientProjectDirectory)/$(ArticulatePackageLane)</ClientWorkspaceDirectory>
    <ArticulateClientWorkspaceError Condition="!Exists('$(ClientWorkspaceDirectory)/package.json')">$([System.Int32]::Parse("No Backoffice client workspace for ArticulatePackageLane '$(ArticulatePackageLane)' at $(ClientWorkspaceDirectory)."))</ArticulateClientWorkspaceError>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableClientBuild)'=='true'">
    <ClientBuildInput Include="$(MSBuildProjectFullPath)" />
    <ClientBuildInput Include="$(MSBuildProjectDirectory)/../../Directory.Build.props" />
    <ClientBuildInput Include="$(MSBuildProjectDirectory)/../../Directory.Build.props.user" Condition="Exists('$(MSBuildProjectDirectory)/../../Directory.Build.props.user')" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/.npmrc" Condition="Exists('$(ClientProjectDirectory)/.npmrc')" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/package.json" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/pnpm-lock.yaml" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/pnpm-workspace.yaml" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/common/**/*" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/package.json" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/tsconfig*.json" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/vite.config.ts" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/ambient.d.ts" />
    <ClientBuildInput Include="$(MSBuildProjectDirectory)/wwwroot/App_Plugins/Articulate/Themes/**/assets/src/**/*" />
    <ClientBuildInput Include="$(MSBuildProjectDirectory)/wwwroot/App_Plugins/Articulate/MarkdownEditor/assets/src/**/*" />
  </ItemGroup>

  <!-- Ignore wwwroot output left by builds before per-lane client assets. -->
  <ItemGroup>
    <Content Remove="wwwroot\App_Plugins\Articulate\BackOffice\**;wwwroot\App_Plugins\Articulate\umbraco-package.json" />
  </ItemGroup>

  <Target Name="BuildBackofficeClient" Condition="'$(EnableClientBuild)'=='true' and '$(NoBuild)'!='true'" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(ClientBuildInput)" Outputs="$(ClientBuildStamp)">
    <Message Text="Building Articulate BackOffice Client (Incremental)..." Importance="High" />
    <PropertyGroup>
      <_ResolvedArticulateAppVersion Condition="'$(ArticulateAppVersion)'!=''">$(ArticulateAppVersion)</_ResolvedArticulateAppVersion>
      <_ResolvedArticulateAppVersion Condition="'$(_ResolvedArticulateAppVersion)'=='' and '$(NBGV_SemVer2)'!=''">$(NBGV_SemVer2)</_ResolvedArticulateAppVersion>
      <_ResolvedArticulateAppVersion Condition="'$(_ResolvedArticulateAppVersion)'=='' and '$(PackageVersion)'!=''">$(PackageVersion)</_ResolvedArticulateAppVersion>
      <_ResolvedArticulateAppVersion Condition="'$(_ResolvedArticulateAppVersion)'=='' and '$(Version)'!=''">$(Version)</_ResolvedArticulateAppVersion>
    </PropertyGroup>

    <Exec Command="pnpm install --frozen-lockfile --prefer-offline" WorkingDirectory="$(ClientProjectDirectory)" IgnoreExitCode="true" Condition="'$(CI)' == 'true'">
      <Output TaskParameter="ExitCode" PropertyName="PnpmFrozenExitCode" />
    </Exec>
    <Error Text="pnpm-lock.yaml is out of sync. Run 'pnpm install' locally." Condition="'$(PnpmFrozenExitCode)' != '0' and '$(PnpmFrozenExitCode)' != ''" />

    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(ClientProjectDirectory)" Condition="'$(CI)' != 'true'" />

    <Exec Command="$(ClientBuildCommand)" WorkingDirectory="$(ClientWorkspaceDirectory)" EnvironmentVariables="ARTICULATE_APP_VERSION=$(_ResolvedArticulateAppVersion)" />

    <PropertyGroup>
      <_OtherClientBuildMode>dev</_OtherClientBuildMode>
      <_OtherClientBuildMode Condition="'$(ClientBuildMode)' == 'dev'">prod</_OtherClientBuildMode>
    </PropertyGroup>
    <ItemGroup>
      <_StaleClientBuildStamp Include="$(BaseIntermediateOutputPath)BackofficeClient_*.stamp" />
      <!-- Both lanes share the theme and Markdown Editor bundles, so every lane's stamp for the other mode is stale. -->
      <_StaleClientBuildStamp Include="obj\*\BackofficeClient_*_$(_OtherClientBuildMode)_*.stamp" />
    </ItemGroup>
    <Delete Files="@(_StaleClientBuildStamp)" />
    <WriteLinesToFile File="$(ClientBuildStamp)" Lines="$([System.DateTime]::UtcNow.ToString('o'))" Overwrite="true" />
  </Target>

  <!-- @(Content) is evaluated at project load, before any target runs, so
       the default wwwroot/ glob misses anything Vite emits. Re-add the
       Vite outputs explicitly after Vite runs so the SDK's static-web-asset
       discovery can find them. Paths must be project-relative - absolute
       paths fail the SDK's "starts with wwwroot/" Identity filter. -->
  <Target Name="RefreshBackofficeStaticWebAssetItems" AfterTargets="BuildBackofficeClient" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(EnableClientBuild)'=='true' and '$(NoBuild)'!='true'">
    <Message Text="Refreshing BackOffice assets..." Importance="Low" />
    <ItemGroup>
      <Content Remove="wwwroot\App_Plugins\Articulate\Themes\**\assets\**" />
      <Content Include="wwwroot\App_Plugins\Articulate\Themes\**\assets\**" />
      <Content Include="wwwroot\App_Plugins\Articulate\MarkdownEditor\assets\dist\**" />
    </ItemGroup>
  </Target>

  <!-- Serve the lane's client assets from obj as static web assets. -->
  <PropertyGroup>
    <ResolveCoreStaticWebAssetsDependsOn>$(ResolveCoreStaticWebAssetsDependsOn);ResolveBackofficeStaticWebAssets</ResolveCoreStaticWebAssetsDependsOn>
  </PropertyGroup>
  <Target Name="ResolveBackofficeStaticWebAssets" Condition="'$(NoBuild)' != 'true'" DependsOnTargets="ResolveProjectStaticWebAssets">
    <ItemGroup>
      <_BackofficeStaticWebAssetCandidate Include="$(ClientAssetsDir)**">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      </_BackofficeStaticWebAssetCandidate>
    </ItemGroup>
    <DefineStaticWebAssets Condition="'@(_BackofficeStaticWebAssetCandidate)' != ''"
      CandidateAssets="@(_BackofficeStaticWebAssetCandidate)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      SourceType="Computed"
      SourceId="$(PackageId)"
      ContentRoot="$(ClientAssetsDir)"
      BasePath="$(StaticWebAssetBasePath)"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_BackofficeStaticWebAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints Condition="'@(_BackofficeStaticWebAsset)' != ''"
      CandidateAssets="@(_BackofficeStaticWebAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

  <Target Name="CleanClientAssets" AfterTargets="Clean" Condition="'$(EnableClientBuild)'=='true'">
    <ItemGroup>
      <_ClientBuildStamp Include="$(BaseIntermediateOutputPath)BackofficeClient_*.stamp" />
    </ItemGroup>
    <Delete Files="@(_ClientBuildStamp)" />
    <RemoveDir Directories="$(ClientAssetsDir)" />
  </Target>



</Project>
