<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Articulate</PackageId>
    <Title>Articulate</Title>
    <AssemblyName>Articulate.Web</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <nullable>enable</nullable>
    <UseArticulateUsings>true</UseArticulateUsings>
    <!-- ENABLE Modern Web Assets (Replaces the need for targets files) -->
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <!-- Allow Hybrid Mode (Serve as StaticContent, Embed as Resource) -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);IncludeProjectReferenceDlls
    </TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Articulate\Articulate.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship Articulate.dll alongside Articulate.Web.dll via BuildOutputInPackage. -->
  <Target Name="IncludeProjectReferenceDlls">
    <ItemGroup>
      <BuildOutputInPackage Include="..\Articulate\bin\$(Configuration)\$(TargetFramework)\Articulate.dll" />
      <BuildOutputInPackage Include="..\Articulate\bin\$(Configuration)\$(TargetFramework)\Articulate.xml" Condition="Exists('..\Articulate\bin\$(Configuration)\$(TargetFramework)\Articulate.xml')" />
    </ItemGroup>
  </Target>
  <!--
    Articulate.Core's runtime deps (ProjectReference is PrivateAssets, so
    they have to be redeclared here for the packed Articulate nuspec).
    Keep this in sync with src/Articulate/Articulate.csproj.
  -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Argotic.Core" />
    <PackageReference Include="FileSignatures" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="WilderMinds.MetaWeblog" />
    <PackageReference Include="System.ServiceModel.Syndication" />
  </ItemGroup>

  <!-- Build targets shipped with the package (copies XML docs for Swagger) -->
  <ItemGroup>
    <Content Include="build\Articulate.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!-- Lock files are restore-time inputs for <RestoreLockedMode>; never ship them. -->
  <ItemGroup>
    <Content Remove="packages.*.lock.json" />
    <None Remove="packages.*.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed theme VIEWS from App_Plugins -->
    <EmbeddedResource Include="App_Plugins\Articulate\Themes\**\Views\**">
      <LogicalName>Articulate.Theme://Themes/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Embed theme ASSETS from wwwroot -->
    <EmbeddedResource Include="wwwroot\App_Plugins\Articulate\Themes\**\assets\**">
      <LogicalName>Articulate.Theme://Themes/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Client sources are build inputs; only compiled BackOffice assets belong in the package. -->
  <ItemGroup>
    <Content Remove="Client\**" />
  </ItemGroup>
  <PropertyGroup>
    <ClientProjectDirectory>$(MSBuildProjectDirectory)/Client</ClientProjectDirectory>
    <ExpectedUmbracoClientVersion Condition="'$(ArticulatePackageLane)' == 'v17'">17</ExpectedUmbracoClientVersion>
    <ExpectedUmbracoClientVersion Condition="'$(ArticulatePackageLane)' == 'v18'">18</ExpectedUmbracoClientVersion>
    <!-- Derive UmbracoClientVersion from ArticulatePackageLane unless the caller set it explicitly. -->
    <UmbracoClientVersion Condition="'$(UmbracoClientVersion)' == ''">$(ExpectedUmbracoClientVersion)</UmbracoClientVersion>
    <ArticulateClientVersionValidationError Condition="'$(UmbracoClientVersion)' != '17' and '$(UmbracoClientVersion)' != '18'">$([System.Int32]::Parse("UmbracoClientVersion must be '17' or '18' (got '$(UmbracoClientVersion)')."))</ArticulateClientVersionValidationError>
    <ArticulateClientLaneConsistencyError Condition="'$(ExpectedUmbracoClientVersion)' != '' and '$(UmbracoClientVersion)' != '$(ExpectedUmbracoClientVersion)'">$([System.Int32]::Parse("UmbracoClientVersion '$(UmbracoClientVersion)' is inconsistent with ArticulatePackageLane '$(ArticulatePackageLane)'. Expected '$(ExpectedUmbracoClientVersion)'."))</ArticulateClientLaneConsistencyError>
    <ClientWorkspaceDirectory>$(ClientProjectDirectory)</ClientWorkspaceDirectory>
    <ClientWorkspaceDirectory Condition="'$(UmbracoClientVersion)' == '17'">$(ClientProjectDirectory)/v17</ClientWorkspaceDirectory>
    <ClientWorkspaceDirectory Condition="'$(UmbracoClientVersion)' == '18'">$(ClientProjectDirectory)/v18</ClientWorkspaceDirectory>
    <BackofficeOutputDir>$(MSBuildProjectDirectory)/wwwroot/App_Plugins/Articulate/BackOffice</BackofficeOutputDir>
    <ClientAssetsCacheDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../build/ClientAssets'))</ClientAssetsCacheDir>
    <ClientBuildStamp>$(ClientAssetsCacheDir)/BackofficeClient_v$(UmbracoClientVersion).stamp</ClientBuildStamp>
    <ClientBuildTargetFramework>net10.0</ClientBuildTargetFramework>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableClientBuild)'=='true'">
    <ClientBuildInput Include="$(ClientProjectDirectory)/pnpm-lock.yaml" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/pnpm-workspace.yaml" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/common/**/*" />
    <ClientBuildInput Include="$(ClientProjectDirectory)/scripts/**/*" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/package.json" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/tsconfig*.json" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/vite.config.ts" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/public/**/*" />
    <ClientBuildInput Include="$(ClientWorkspaceDirectory)/ambient.d.ts" />
    <ClientBuildInput Include="$(MSBuildProjectDirectory)/wwwroot/App_Plugins/Articulate/Themes/**/assets/src/**/*" />
    <ClientBuildInput Include="$(MSBuildProjectDirectory)/wwwroot/App_Plugins/Articulate/MarkdownEditor/assets/src/**/*" />
  </ItemGroup>

  <!--
    VS holds an exclusive lock on the BackOffice dir during build, so when
    building inside VS we treat the assets as <None> (won't be packed); CLI
    builds skip this and pick them up as Content.
  -->
  <ItemGroup Condition="'$(EnableClientBuild)'=='true' and '$(BuildingInsideVisualStudio)'=='true'">
    <Content Remove="$(BackofficeOutputDir)\**" />
    <None Include="$(BackofficeOutputDir)\**" />
  </ItemGroup>

  <Target Name="BuildBackofficeClient" Condition="'$(EnableClientBuild)'=='true' and '$(TargetFramework)'=='$(ClientBuildTargetFramework)'" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(ClientBuildInput)" Outputs="$(ClientBuildStamp)">
    <Message Text="Building Articulate BackOffice Client (Incremental)..." Importance="High" />
    <MakeDir Directories="$(ClientAssetsCacheDir)" />
    <PropertyGroup>
      <_ResolvedArticulateAppVersion Condition="'$(ArticulateAppVersion)'!=''">$(ArticulateAppVersion)</_ResolvedArticulateAppVersion>
      <_ResolvedArticulateAppVersion Condition="'$(_ResolvedArticulateAppVersion)'=='' and '$(NBGV_SemVer2)'!=''">$(NBGV_SemVer2)</_ResolvedArticulateAppVersion>
      <_ResolvedArticulateAppVersion Condition="'$(_ResolvedArticulateAppVersion)'=='' and '$(PackageVersion)'!=''">$(PackageVersion)</_ResolvedArticulateAppVersion>
      <_ResolvedArticulateAppVersion Condition="'$(_ResolvedArticulateAppVersion)'=='' and '$(Version)'!=''">$(Version)</_ResolvedArticulateAppVersion>
    </PropertyGroup>

    <Exec Command="pnpm install --frozen-lockfile --prefer-offline" WorkingDirectory="$(ClientProjectDirectory)" IgnoreExitCode="true" Condition="'$(CI)' == 'true'">
      <Output TaskParameter="ExitCode" PropertyName="PnpmFrozenExitCode" />
    </Exec>
    <Error Text="pnpm-lock.yaml is out of sync. Run 'pnpm install' locally." Condition="'$(PnpmFrozenExitCode)' != '0' and '$(PnpmFrozenExitCode)' != ''" />

    <Exec Command="pnpm install" WorkingDirectory="$(ClientProjectDirectory)" Condition="'$(CI)' != 'true'" />

    <Exec Command="$(ClientBuildCommand)" WorkingDirectory="$(ClientWorkspaceDirectory)" EnvironmentVariables="ARTICULATE_APP_VERSION=$(_ResolvedArticulateAppVersion)" />

    <WriteLinesToFile File="$(ClientBuildStamp)" Lines="$([System.DateTime]::UtcNow.ToString('o'))" Overwrite="true" />
  </Target>

  <!-- @(Content) is evaluated at project load, before any target runs, so
       the default wwwroot/ glob misses anything Vite emits. Re-add the
       Vite outputs explicitly after Vite runs so the SDK's static-web-asset
       discovery can find them. Paths must be project-relative - absolute
       paths fail the SDK's "starts with wwwroot/" Identity filter. -->
  <Target Name="RefreshBackofficeStaticWebAssetItems" AfterTargets="BuildBackofficeClient" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(EnableClientBuild)'=='true'">
    <Message Text="Refreshing BackOffice assets..." Importance="Low" />
    <ItemGroup>
      <Content Remove="$(BackofficeOutputDir)\**" />
      <Content Include="wwwroot\App_Plugins\Articulate\BackOffice\**" />
      <Content Remove="wwwroot\App_Plugins\Articulate\Themes\**\assets\**" />
      <Content Include="wwwroot\App_Plugins\Articulate\Themes\**\assets\**" />
      <Content Include="wwwroot\App_Plugins\Articulate\MarkdownEditor\assets\dist\**" />
      <Content Include="wwwroot\App_Plugins\Articulate\umbraco-package.json" />
    </ItemGroup>
  </Target>

  <Target Name="EnsureClientAssets" Condition="'$(EnableClientBuild)'=='true' and '$(TargetFramework)'!='$(ClientBuildTargetFramework)' and !Exists('$(ClientBuildStamp)')" BeforeTargets="ResolveProjectStaticWebAssets">
    <Message Text="Client assets missing for $(TargetFramework); triggering BuildBackofficeClient..." Importance="High" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="BuildBackofficeClient" Properties="TargetFramework=$(ClientBuildTargetFramework);Configuration=$(Configuration);ArticulatePackageLane=$(ArticulatePackageLane);UmbracoClientVersion=$(UmbracoClientVersion)" />
  </Target>

  <Target Name="CleanClientAssets" AfterTargets="Clean" Condition="'$(EnableClientBuild)'=='true'">
    <Delete Condition="Exists('$(ClientBuildStamp)')" Files="$(ClientBuildStamp)" />
    <RemoveDir Directories="$(BackofficeOutputDir)" />
  </Target>



</Project>
