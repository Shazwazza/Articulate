<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- PackageId differentiates this from Articulate.Web's PackageId=Articulate during restore -->
    <PackageId>Articulate.Core</PackageId>
    <UseArticulateUsings>true</UseArticulateUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" PrivateAssets="All" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />

    <PackageReference Include="Umbraco.Cms.Api.Management" />

    <PackageReference Include="Argotic.Core" />
    <PackageReference Include="FileSignatures" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="WilderMinds.MetaWeblog" />
    <PackageReference Include="System.ServiceModel.Syndication" />
  </ItemGroup>

  <ItemGroup Label="Force minimum versions">
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="Articulate.Web" />
    <InternalsVisibleTo Include="Articulate.Tests" />
  </ItemGroup>

  <!-- RESOURCES: Only embed things specific to Core (The Starter Kit Installer data) -->
  <ItemGroup>
    <EmbeddedResource Include="Packaging\author.jpg" />
    <EmbeddedResource Include="Packaging\banner.jpg" />
    <EmbeddedResource Include="Packaging\logo.png" />
    <EmbeddedResource Include="Packaging\package.zip" />
    <EmbeddedResource Include="Packaging\post1.jpg" />
    <EmbeddedResource Include="Packaging\post2.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controllers\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Controllers\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
